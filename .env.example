# Copy this file to .env and fill in real values. Do not commit .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# PostgreSQL connection
DATABASE_NAME=fitlogger
DATABASE_USER=postgres
DATABASE_PASSWORD=your-postgres-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# AI planner (server-side only — never exposed to the browser)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=60

# Admin account password (used only by: python manage.py seed_admin)
ADMIN_PASSWORD=set-a-strong-admin-password

# Local PostgreSQL used only by the test suite, so tests never run against the
# hosted database: python manage.py test --settings=fitlogger.settings_test
LOCAL_DATABASE_NAME=fitlogger
LOCAL_DATABASE_USER=postgres
LOCAL_DATABASE_PASSWORD=your-local-postgres-password

# Email delivery (Brevo transactional HTTP API — Vercel blocks outbound SMTP)
BREVO_API_KEY=your-brevo-v3-api-key
DEFAULT_FROM_EMAIL=Fit Logger <your-verified-brevo-sender@gmail.com>
# Absolute base for links inside emails. Production: https://your-app.vercel.app
SITE_BASE_URL=http://127.0.0.1:8000
# Set to 1 to send real mail while DEBUG=True, instead of printing to console.
EMAIL_SEND_FOR_REAL=0
